# Discord Developer Portal > Bot
DISCORD_TOKEN=replace-with-your-bot-token
# Discord Developer Portal > General Information > Application ID
DISCORD_CLIENT_ID=replace-with-your-application-id
# Optional: test server ID for near-instant slash command registration
BOT_GUILD_ID=

# Generate a long random value; the web API and bot must use the same value
BOT_API_KEY=replace-with-a-long-random-secret
API_BASE_URL=http://127.0.0.1:3000

# Web app settings
HOST=127.0.0.1
PORT=3000
# Optional path for persistent listing data
# DATA_FILE=./data/servers.json